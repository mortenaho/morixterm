<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Morixterm.Desktop.App">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="#202124" />
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>
    <Style Selector="Button.toolButton">
      <Setter Property="Background" Value="#303134" />
      <Setter Property="BorderBrush" Value="#4a4d52" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Margin" Value="3" />
    </Style>
    <Style Selector="Button.toolButton:pointerover">
      <Setter Property="Background" Value="#3b3f45" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#9aa0a6" />
    </Style>
  </Application.Styles>
</Application>
