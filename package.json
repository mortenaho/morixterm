{
  "name": "morixterm",
  "version": "2.0.3",
  "desktopName": "com.morixterm.desktop",
  "description": "A modern workstation for SSH, RDP, terminals and remote files.",
  "main": "dist-electron/main.js",
  "author": {
    "name": "MoriXterm",
    "email": "mortenaho@users.noreply.github.com",
    "url": "https://github.com/mortenaho/morixterm"
  },
  "homepage": "https://github.com/mortenaho/morixterm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mortenaho/morixterm.git"
  },
  "license": "MIT",
  "scripts": {
    "predev": "tsc -p electron/tsconfig.json",
    "dev": "concurrently -k \"vite --strictPort\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "tsc -b && vite build && tsc -p electron/tsconfig.json",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run build && node --test tests/*.test.cjs",
    "prepare-native-modules": "node node_modules/cpu-features/buildcheck.js > node_modules/cpu-features/buildcheck.gypi",
    "package": "npm run build && npm run prepare-native-modules && electron-builder"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.3.0",
    "electron-log": "^5.2.0",
    "electron-store": "^9.0.0",
    "keytar": "^7.9.0",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.17.0",
    "sweetalert2": "^11.26.25",
    "zod": "^3.23.8",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.morixterm.desktop",
    "productName": "MoriXterm",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": true
    },
    "files": [
      "dist",
      "dist-electron",
      "assets/branding/**/*"
    ],
    "directories": {
      "buildResources": "assets/branding",
      "output": "release"
    },
    "linux": {
      "maintainer": "MoriXterm <mortenaho@users.noreply.github.com>",
      "target": ["AppImage", "deb"],
      "icon": "assets/branding/morixterm-icon.png",
      "syncDesktopName": true,
      "category": "Network"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/branding/morixterm-icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/branding/morixterm-icon.png"
    }
  }
}
